// ほしぞら絵本の公開（Cloudflare Workers）。アプリのファイル（dist）を配り、/sync/ だけ sync/worker.js が答える（「よんだよ」の星を端末どうしで そろえる）。
// 送り出し: node tools/build.cjs && node tests/build.test.cjs && npx wrangler@4 deploy
// 名前を変えると公開アドレスが変わり、端末の「読んだよ」が引き継がれないので変えない。
// 同期の合言葉 SYNC_KEY は secret に入れ、ここには書かない（npx wrangler@4 secret put SYNC_KEY）。入れるまで /sync/ は閉じている。
{
  "name": "hoshizora-ehon-edd931",
  "main": "sync/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/sync/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hoshizora-ehon-sync",
      // 2026-11-27 に作成（アジア太平洋）
      "database_id": "3605295c-fdaa-461f-a1a1-c33c913c58bc",
      "migrations_dir": "sync/migrations"
    }
  ]
}
